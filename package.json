{
  "name": "web-embed-app",
  "version": "1.0.0",
  "description": "嵌入在线网页的Electron应用",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.webembed.app",
    "productName": "网页嵌入器",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "index_with_webview.html",
      "config.json",
      "package.json",
      "node_modules/**/*"
    ],
    "extraFiles": [
      {
        "from": "config.json",
        "to": "config.json"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3"
  }
}
